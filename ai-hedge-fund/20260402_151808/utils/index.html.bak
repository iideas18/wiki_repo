}
ANALYST_ORDER = sorted(ANALYST_CONFIG.keys(), key=lambda k: ANALYST_CONFIG[k]["order"])</code><button class="copy-btn" onclick="copyCode(this)">Copy</button></pre>

    <pre><code class="language-python"># AgentProgress — Rich Live display for real-time tracking
class AgentProgress:
    def __init__(self):
        self.agent_status = {}
        self.update_handlers = []
        self.live = Live(console=Console())

    def update(self, agent_name, status, detail=""):
        self.agent_status[agent_name] = {"status": status, "detail": detail}
        for handler in self.update_handlers:
            handler(agent_name, status, detail)
        self._refresh_display()

    def _refresh_display(self):
        table = Table(title="Agent Progress")
        table.add_column("Agent"); table.add_column("Status"); table.add_column("Detail")
        for name in sorted(self.agent_status):
            info = self.agent_status[name]
            table.add_row(name, info["status"], info["detail"])
        self.live.update(table)</code><button class="copy-btn" onclick="copyCode(this)">Copy</button></pre>

    <h3 id="code-examples">Code Examples</h3>
    <pre><code class="language-python"># call_llm — unified LLM invocation with retry and fallback
def call_llm(prompt, model_name, model_provider, pydantic_model=None,
             max_retries=3, default_factory=None):
    model = get_model(model_name, model_provider)
    for attempt in range(max_retries):
        try:
            if pydantic_model:
                response = model.invoke(prompt)
                parsed = extract_json_from_response(response.content)
                return pydantic_model.model_validate(parsed)
            return model.invoke(prompt).content
        except Exception as e:
            if attempt == max_retries - 1:
                if default_factory:
                    return default_factory()
                raise
            continue</code><button class="copy-btn" onclick="copyCode(this)">Copy</button></pre>


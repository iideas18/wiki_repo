</main>

<!-- Diagram fullscreen overlay -->
<div class="diagram-overlay" id="diagramOverlay">
  <div class="diagram-overlay-content" id="diagramOverlayContent"></div>
</div>

<script>
// === Auto-generate TOC from H2/H3 headings ===
(function(){
  var toc = document.getElementById('toc');
  if (!toc) return;
  var headings = document.querySelectorAll('h2[id], h3[id]');
  var ol = document.createElement('ol');
  var currentH2Li = null;
  headings.forEach(function(h) {
    if (h.closest('#toc, .toc')) return;
    var li = document.createElement('li');
    var a = document.createElement('a');
    a.href = '#' + h.id;
    a.textContent = h.textContent;
    li.appendChild(a);
    if (h.tagName === 'H3' && currentH2Li) {
      var sub = currentH2Li.querySelector('ol');
      if (!sub) { sub = document.createElement('ol'); currentH2Li.appendChild(sub); }
      sub.appendChild(li);
    } else {
      ol.appendChild(li);
      if (h.tagName === 'H2') currentH2Li = li;
    }
  });
  toc.appendChild(ol);
})();

// === Reading time estimate ===
(function(){
  var m = document.querySelector('main');
  if (!m) return;
  var words = m.textContent.trim().split(/\s+/).length;
  var mins = Math.ceil(words / 200);
  var hero = document.querySelector('.hero');
  if (hero) {
    var rt = document.createElement('p');
    rt.style.cssText = 'font-size:.85rem;color:var(--text-muted);margin-top:.5rem';
    rt.textContent = '\u23F1 ~' + mins + ' min read';
    hero.appendChild(rt);
  }
})();

// === Save original mermaid source before any rendering ===
document.querySelectorAll('pre.mermaid').forEach(function(el) {
  if (!el.getAttribute('data-source')) {
    el.setAttribute('data-source', el.textContent);
  }
});

// === Theme toggle ===
(function(){
  var btn = document.getElementById('themeToggle');
  var hljsLink = document.getElementById('hljs-theme');
  var darkHL = 'https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/styles/github-dark.min.css';
  var lightHL = 'https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/styles/github.min.css';

  function renderMermaid(t) {
    var nodes = document.querySelectorAll('pre.mermaid');
    if (!nodes.length || !window.mermaid) return;
    nodes.forEach(function(el) {
      var src = el.getAttribute('data-source');
      if (src) {
        el.removeAttribute('data-processed');
        el.textContent = src;
      }
    });
    try {
      mermaid.initialize({
        startOnLoad: false,
        theme: (t === 'light') ? 'default' : 'dark',
        flowchart: { useMaxWidth: true, htmlLabels: true, curve: 'basis' }
      });
      mermaid.run();
    } catch(e) {
      console.warn('mermaid re-render:', e);
    }
  }

  function applyTheme(t) {
    document.documentElement.setAttribute('data-theme', t);
    hljsLink.href = (t === 'light') ? lightHL : darkHL;
    btn.textContent = (t === 'light') ? '\u2600' : '\u263E';
    localStorage.setItem('neutra-ip-theme', t);
    renderMermaid(t);
  }

  var saved = localStorage.getItem('neutra-ip-theme') ||
    (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  applyTheme(saved);

  btn.addEventListener('click', function(){
    var current = document.documentElement.getAttribute('data-theme');
    applyTheme(current === 'light' ? 'dark' : 'light');
  });
})();

// === Code copy buttons ===
document.querySelectorAll('pre code').forEach(function(block) {
  var pre = block.parentElement;
  if (!pre || pre.classList.contains('mermaid')) return;
  var btn = document.createElement('button');
  btn.className = 'copy-btn';
  btn.textContent = 'Copy';
  btn.setAttribute('aria-label', 'Copy code to clipboard');
  btn.addEventListener('click', function() {
    navigator.clipboard.writeText(block.textContent).then(function() {
      btn.textContent = 'Copied!';
      setTimeout(function(){ btn.textContent = 'Copy'; }, 1500);
    });
  });
  pre.appendChild(btn);
});

// === Diagram overlay with cloneNode and scroll-wheel zoom ===
(function(){
  var overlay = document.getElementById('diagramOverlay');
  var content = document.getElementById('diagramOverlayContent');
  if (!overlay || !content) return;
  var scale = 1;

  function resetZoom() {
    scale = 1;
    content.style.transform = 'scale(1)';
  }

  function openOverlay(dc) {
    content.innerHTML = '';
    var svg = dc.querySelector('svg');
    if (svg) {
      var clone = svg.cloneNode(true);
      clone.style.maxWidth = '90vw';
      clone.style.maxHeight = '85vh';
      clone.style.width = '90vw';
      content.appendChild(clone);
    }
    resetZoom();
    overlay.classList.add('active');
  }

  document.querySelectorAll('.diagram-container').forEach(function(dc) {
    dc.addEventListener('click', function() { openOverlay(dc); });
  });

  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) {
      overlay.classList.remove('active');
      resetZoom();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      overlay.classList.remove('active');
      resetZoom();
    }
  });

  content.addEventListener('wheel', function(e) {
    if (!overlay.classList.contains('active')) return;
    e.preventDefault();
    var d = e.deltaY > 0 ? -0.1 : 0.1;
    scale = Math.min(5.0, Math.max(0.5, scale + d));
    content.style.transform = 'scale(' + scale + ')';
  }, { passive: false });
})();

// === Back to top ===
(function(){
  var b = document.getElementById('backToTop');
  if (!b) return;
  window.addEventListener('scroll', function() {
    b.classList.toggle('visible', window.scrollY > 400);
  });
  b.addEventListener('click', function() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();

// === Keyboard navigation: j/k scroll H2 sections ===
(function(){
  var h2s = Array.from(document.querySelectorAll('h2[id]'));
  function currentIdx() {
    var scrollY = window.scrollY;
    for (var i = h2s.length - 1; i >= 0; i--) {
      if (h2s[i].offsetTop <= scrollY + 80) return i;
    }
    return -1;
  }
  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;
    if (e.key === 'j') {
      var ci = currentIdx();
      if (ci < h2s.length - 1) h2s[ci + 1].scrollIntoView({ behavior: 'smooth' });
      e.preventDefault();
    } else if (e.key === 'k') {
      var ci2 = currentIdx();
      if (ci2 > 0) h2s[ci2 - 1].scrollIntoView({ behavior: 'smooth' });
      e.preventDefault();
    }
  });
})();

// === Highlight.js ===
hljs.highlightAll();
</script>
</body>
</html>

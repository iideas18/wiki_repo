<h3 id="quick-start">Quick Start</h3>
<pre><code class="language-python"># Run a single analysis on AAPL and NVDA
python src/main.py --ticker AAPL,NVDA \
    --model-provider openai --model gpt-4o \
    --start-date 2025-01-01 --end-date 2025-03-31 \
    --initial-cash 100000 --show-reasoning

# Backtest the strategy over 6 months
python src/main.py --ticker AAPL,MSFT,NVDA \
    --start-date 2024-07-01 --end-date 2025-01-01 \
    --backtest --initial-cash 500000
</code></pre>


    <h3 id="code-examples">Code Examples</h3>
    <pre><code class="language-python"># The AgentState TypedDict — heart of the workflow
import operator
from typing import Annotated, TypedDict
from langchain_core.messages import BaseMessage

def merge_dicts(a: dict, b: dict) -> dict:
    """Shallow merge — b overwrites a for matching keys."""
    if a is None:
        return b or {}
    if b is None:
        return a
    return {**a, **b}

class AgentState(TypedDict):
    messages: Annotated[list[BaseMessage], operator.add]
    data: Annotated[dict, merge_dicts]
    metadata: Annotated[dict, merge_dicts]</code><button class="copy-btn" onclick="copyCode(this)">Copy</button></pre>

    <pre><code class="language-python"># Debug helper — show_agent_reasoning
import json

def convert_to_serializable(obj):
    if hasattr(obj, 'model_dump'):
        return obj.model_dump()
    if hasattr(obj, '__dict__'):
        return obj.__dict__
    return str(obj)

def show_agent_reasoning(reasoning, agent_name):
    print(f"\n{'='*50}")
    print(f"Agent: {agent_name}")
    print(f"{'='*50}")
    serializable = convert_to_serializable(reasoning)
    print(json.dumps(serializable, indent=2, default=str))</code><button class="copy-btn" onclick="copyCode(this)">Copy</button></pre>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/python.min.js"></script>
  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ startOnLoad: false, theme: document.documentElement.getAttribute('data-theme') === 'light' ? 'default' : 'dark' });
    await mermaid.run({ querySelector: '.mermaid' });
  </script>
  <script>
    function toggleTheme() {
      const html = document.documentElement;
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('neutra-ip-theme', next);
      document.querySelector('.theme-toggle').textContent = next === 'dark' ? '🌙 Theme' : '☀️ Theme';
    }
    (function(){
      const saved = localStorage.getItem('neutra-ip-theme');
      if (saved) {
        document.documentElement.setAttribute('data-theme', saved);
        document.querySelector('.theme-toggle').textContent = saved === 'dark' ? '🌙 Theme' : '☀️ Theme';
      }
    })();

    (function(){
      const toc = document.getElementById('toc');
      const ul = document.createElement('ul');
      document.querySelectorAll('h2[id], h3[id]').forEach(h => {
        const li = document.createElement('li');
        if (h.tagName === 'H3') li.classList.add('h3');
        const a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent;
        li.appendChild(a);
        ul.appendChild(li);
      });
      toc.appendChild(ul);
    })();

    function copyCode(btn) {
      const code = btn.parentElement.querySelector('code').textContent;
      navigator.clipboard.writeText(code).then(() => { btn.textContent = 'Copied!'; setTimeout(() => btn.textContent = 'Copy', 2000); });
    }

    function openOverlay(wrapper) {
      const overlay = document.getElementById('diagram-overlay');
      const container = document.getElementById('overlay-diagram');
      const svg = wrapper.querySelector('svg');
      if (!svg) return;
      container.innerHTML = '';
      const clone = svg.cloneNode(true);
      clone.style.maxWidth = '100%';
      container.appendChild(clone);
      overlay.classList.add('active');
      let scale = 1;
      container.addEventListener('wheel', function(e) {
        e.preventDefault();
        scale += e.deltaY > 0 ? -0.1 : 0.1;
        scale = Math.max(0.3, Math.min(3, scale));
        clone.style.transform = 'scale(' + scale + ')';
      });
    }
    function closeOverlay() { document.getElementById('diagram-overlay').classList.remove('active'); }
    document.getElementById('diagram-overlay').addEventListener('click', function(e) { if (e.target === this) closeOverlay(); });

    window.addEventListener('scroll', function() {
      document.getElementById('back-to-top').style.display = window.scrollY > 400 ? 'block' : 'none';
    });

    (function(){
      const text = document.getElementById('main-content').textContent;
      const words = text.trim().split(/\s+/).length;
      const mins = Math.ceil(words / 200);
      document.getElementById('reading-time').textContent = '📖 ' + mins + ' min read';
    })();

    document.addEventListener('keydown', function(e) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      const sections = Array.from(document.querySelectorAll('h2[id], h3[id]'));
      if (e.key === 'j' || e.key === 'k') {
        const scrollY = window.scrollY + 100;
        let idx = sections.findIndex(s => s.offsetTop > scrollY);
        if (e.key === 'k') idx = Math.max(0, idx - 2); else if (idx < 0) idx = sections.length - 1;
        if (sections[idx]) sections[idx].scrollIntoView({ behavior: 'smooth' });
      }
    });

    hljs.highlightAll();
  </script>
</body>

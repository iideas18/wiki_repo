<!-- ───────────── Configuration ───────────── -->
<h2 id="configuration">Configuration</h2>
<table>
  <tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr>
  <tr><td><code>initial_capital</code></td><td>float</td><td>100,000</td><td>Starting cash balance for the simulated portfolio</td></tr>
  <tr><td><code>margin_requirement</code></td><td>float</td><td>0.0</td><td>Fraction of short value held as margin (0 = no margin)</td></tr>
  <tr><td><code>start_date</code></td><td>str</td><td>—</td><td>Backtest start date (YYYY-MM-DD)</td></tr>
  <tr><td><code>end_date</code></td><td>str</td><td>—</td><td>Backtest end date (YYYY-MM-DD)</td></tr>
  <tr><td><code>tickers</code></td><td>list[str]</td><td>—</td><td>List of stock tickers to trade (e.g. <code>["AAPL","NVDA"]</code>)</td></tr>
  <tr><td><code>model_name</code></td><td>str</td><td>—</td><td>LLM model name (e.g. <code>gpt-4o</code>, <code>claude-sonnet</code>)</td></tr>
  <tr><td><code>model_provider</code></td><td>str</td><td>—</td><td>Provider key: <code>openai</code>, <code>anthropic</code>, <code>groq</code>, etc.</td></tr>
  <tr><td><code>selected_analysts</code></td><td>list[str]</td><td>all</td><td>Subset of analyst agents to run (interactive selection in CLI)</td></tr>
  <tr><td><code>freq</code></td><td>str</td><td><code>'B'</code></td><td>Pandas frequency string for date iteration (business days)</td></tr>
  <tr><td><code>lookback_months</code></td><td>int</td><td>1</td><td>Months of historical data to fetch before start_date for context</td></tr>
  <tr><td><code>benchmark</code></td><td>str</td><td><code>SPY</code></td><td>Benchmark ticker for performance comparison</td></tr>
  <tr><td><code>risk_free_rate</code></td><td>float</td><td>0.0</td><td>Annualized risk-free rate for Sharpe/Sortino calculation</td></tr>
  <tr><td><code>annualization_factor</code></td><td>float</td><td>252</td><td>Trading days per year for annualizing returns</td></tr>
</table>

<!-- ───────────── Code Examples ───────────── -->
<h2 id="code-examples">Code Examples</h2>

<h3>BacktestEngine initialization</h3>
<pre><code class="language-python">class BacktestEngine:
    def __init__(self, tickers, start_date, end_date,
                 initial_capital=100_000, margin_requirement=0.0,
                 model_name="gpt-4o", model_provider="openai",
                 selected_analysts=None):
        self.portfolio = Portfolio(
            tickers=tickers,
            initial_cash=initial_capital,
            margin_requirement=margin_requirement,
        )
        self.controller = AgentController(
            model_name=model_name,
            model_provider=model_provider,
            analysts=selected_analysts or [],
        )
        self.executor = TradeExecutor(self.portfolio)
        self.dates = pd.bdate_range(start_date, end_date, freq="B")
        self.value_points: list[PortfolioValuePoint] = []
</code></pre>

<h3>Portfolio.apply_long_buy</h3>
<pre><code class="language-python">def apply_long_buy(self, ticker: str, quantity: int, price: float) -> None:
    """Buy shares long — deduct cash, update position &amp; cost basis."""
    cost = quantity * price
    if cost > self.cash:
        raise ValueError(f"Insufficient cash: need {cost}, have {self.cash}")
    self.cash -= cost
    pos = self.positions.setdefault(ticker, {"long": 0, "short": 0, "cost_basis": 0.0})
    prev_qty = pos["long"]
    prev_cost = pos["cost_basis"]
    pos["long"] += quantity
    pos["cost_basis"] = (prev_cost * prev_qty + cost) / pos["long"]
</code></pre>

<h3>PerformanceMetrics TypedDict</h3>
<pre><code class="language-python">class PerformanceMetrics(TypedDict):
    sharpe_ratio: float          # Annualized Sharpe ratio
    sortino_ratio: float         # Annualized Sortino ratio (downside only)
    max_drawdown: float          # Maximum peak-to-trough decline (%)
    max_drawdown_date: str       # Date of max drawdown trough
    long_short_ratio: float      # Ratio of long to short exposure
    gross_exposure: float        # |long| + |short| as fraction of NAV
    net_exposure: float          # (long - |short|) as fraction of NAV
    total_return: float          # Cumulative return over the backtest period
    benchmark_return: float      # SPY buy-and-hold return over same period
</code></pre>


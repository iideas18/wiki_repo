<!-- Diagram overlay -->
<div class="diagram-overlay" id="diagramOverlay">
  <div class="diagram-overlay-content" id="diagramOverlayContent"></div>
</div>

<script>
/* ── TOC auto-generation ── */
(function(){
  var toc=document.getElementById('toc');if(!toc)return;
  var headings=document.querySelectorAll('main h2[id], main h3[id]');
  var ol=document.createElement('ol'),lastH2=null;
  headings.forEach(function(h){
    if(toc.contains(h))return;
    var li=document.createElement('li');
    var a=document.createElement('a');
    a.href='#'+h.id;a.textContent=h.textContent;
    li.appendChild(a);
    if(h.tagName==='H2'){ol.appendChild(li);lastH2=li;}
    else if(h.tagName==='H3'&&lastH2){
      var sub=lastH2.querySelector('ol');
      if(!sub){sub=document.createElement('ol');lastH2.appendChild(sub);}
      sub.appendChild(li);
    }
  });
  toc.appendChild(ol);
})();

/* ── Reading time ── */
(function(){
  var main=document.querySelector('main');if(!main)return;
  var words=main.textContent.trim().split(/\s+/).length;
  var mins=Math.max(1,Math.round(words/200));
  var hero=document.querySelector('.hero');if(!hero)return;
  var p=document.createElement('p');
  p.style.cssText='font-size:.85rem;color:var(--text-muted);margin-top:.5rem;margin-bottom:0';
  p.textContent='⏱ ~'+mins+' min read';
  hero.appendChild(p);
})();

/* ── Collapsible tables (8+ rows) ── */
(function(){
  document.querySelectorAll('table').forEach(function(t){
    var rows=t.querySelectorAll('tbody tr, tr');
    if(rows.length<9)return;
    if(t.parentElement&&t.parentElement.classList.contains('collapsible-table'))return;
    var details=document.createElement('details');
    details.className='collapsible-table';
    var summary=document.createElement('summary');
    summary.textContent='Show table ('+rows.length+' rows)';
    details.appendChild(summary);
    t.parentNode.insertBefore(details,t);
    details.appendChild(t);
  });
})();

/* ── Mermaid: save source, then render ── */
document.querySelectorAll('pre.mermaid').forEach(function(el){
  if(!el.getAttribute('data-source'))el.setAttribute('data-source',el.textContent);
});

/* ── Theme toggle ── */
(function(){
  var btn=document.getElementById('themeToggle');
  var hljsLink=document.getElementById('hljs-theme');

  function renderMermaid(theme){
    document.querySelectorAll('pre.mermaid').forEach(function(el){
      var src=el.getAttribute('data-source');if(!src)return;
      el.removeAttribute('data-processed');
      el.textContent=src;
    });
    mermaid.initialize({startOnLoad:false,theme:theme==='light'?'default':'dark'});
    mermaid.run({querySelector:'pre.mermaid'});
  }

  function applyTheme(t){
    document.documentElement.setAttribute('data-theme',t);
    localStorage.setItem('neutra-ip-theme',t);
    btn.textContent=t==='light'?'☾':'☀';
    hljsLink.href='https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/styles/'+(t==='light'?'github.min.css':'github-dark.min.css');
    renderMermaid(t);
    hljs.highlightAll();
  }

  var saved=localStorage.getItem('neutra-ip-theme');
  var initial=saved||(window.matchMedia('(prefers-color-scheme:light)').matches?'light':'dark');
  applyTheme(initial);

  btn.addEventListener('click',function(){
    var cur=document.documentElement.getAttribute('data-theme');
    applyTheme(cur==='dark'?'light':'dark');
  });
})();

/* ── Code copy buttons ── */
document.querySelectorAll('pre').forEach(function(pre){
  var code=pre.querySelector('code');
  if(!code||pre.querySelector('.mermaid'))return;
  var btn=document.createElement('button');
  btn.className='copy-btn';btn.textContent='Copy';
  btn.addEventListener('click',function(){
    navigator.clipboard.writeText(code.textContent).then(function(){
      btn.textContent='Copied!';
      setTimeout(function(){btn.textContent='Copy';},1500);
    });
  });
  pre.appendChild(btn);
});

/* ── Diagram overlay with zoom ── */
(function(){
  var overlay=document.getElementById('diagramOverlay');
  var content=document.getElementById('diagramOverlayContent');
  var scale=1;

  document.querySelectorAll('.diagram-container').forEach(function(dc){
    dc.addEventListener('click',function(){
      var svg=dc.querySelector('svg');if(!svg)return;
      content.innerHTML='';
      var clone=svg.cloneNode(true);
      clone.style.maxWidth='none';clone.style.width='auto';clone.style.height='auto';
      content.appendChild(clone);
      scale=1;content.style.transform='scale(1)';
      overlay.classList.add('active');
    });
  });

  overlay.addEventListener('click',function(e){
    if(e.target===overlay){overlay.classList.remove('active');}
  });

  overlay.addEventListener('wheel',function(e){
    e.preventDefault();
    scale+=e.deltaY>0?-0.15:0.15;
    scale=Math.min(5,Math.max(0.5,scale));
    content.style.transform='scale('+scale+')';
  },{passive:false});

  document.addEventListener('keydown',function(e){
    if(e.key==='Escape')overlay.classList.remove('active');
  });
})();

/* ── Back to top ── */
(function(){
  var btn=document.getElementById('backToTop');
  window.addEventListener('scroll',function(){
    btn.classList.toggle('visible',window.scrollY>400);
  });
  btn.addEventListener('click',function(){
    window.scrollTo({top:0,behavior:'smooth'});
  });
})();

/* ── j/k keyboard navigation ── */
(function(){
  var headings=Array.from(document.querySelectorAll('main h2[id]'));
  if(!headings.length)return;
  document.addEventListener('keydown',function(e){
    if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA')return;
    if(e.key!=='j'&&e.key!=='k')return;
    var scrollY=window.scrollY+80;
    var idx=0;
    for(var i=0;i<headings.length;i++){
      if(headings[i].offsetTop<=scrollY)idx=i;
    }
    if(e.key==='j')idx=Math.min(idx+1,headings.length-1);
    else idx=Math.max(idx-1,0);
    headings[idx].scrollIntoView({behavior:'smooth'});
  });
})();

/* ── Highlight.js init ── */
hljs.highlightAll();
</script>
</body>
</html>

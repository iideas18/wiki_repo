<h2 id="code-examples">Code Examples</h2>

<h3 id="example-basic-backtest">Running a Basic Backtest</h3>

<pre><code class="language-python">from backtesting import BacktestEngine, BacktestConfig
from datetime import datetime

config = BacktestConfig(
    start_date=datetime(2026, 1, 2),
    end_date=datetime(2026, 3, 31),
    tickers=["AAPL", "MSFT"],
    initial_capital=100_000,
)

engine = BacktestEngine(config)
result = engine.run_backtest()

print(f"Total Return: {result.total_return:.2%}")
print(f"Sharpe Ratio: {result.sharpe:.2f}")
print(f"Max Drawdown: {result.max_drawdown:.2%}")
print(f"Alpha vs SPY: {result.alpha:.2%}")
</code></pre>

<h3 id="example-custom-portfolio">Inspecting Portfolio State Mid-Backtest</h3>

<pre><code class="language-python"># Portfolio snapshot after any trading day
snapshot = portfolio.snapshot()

print(f"Cash: ${snapshot.cash:,.2f}")
print(f"Long positions:")
for ticker, pos in snapshot.long_positions.items():
    print(f"  {ticker}: {pos.shares} shares @ ${pos.avg_cost:.2f}")
print(f"Short positions:")
for ticker, pos in snapshot.short_positions.items():
    print(f"  {ticker}: {pos.shares} shares @ ${pos.entry_price:.2f}")
print(f"Total value: ${snapshot.total_value:,.2f}")
</code></pre>

<h3 id="example-metrics-extraction">Extracting Detailed Metrics</h3>

<pre><code class="language-python"># After backtest completes
metrics = result.metrics

# Daily return series for custom analysis
import numpy as np
returns = np.array(metrics.daily_returns)
print(f"Win rate: {(returns > 0).mean():.1%}")
print(f"Best day: {returns.max():.2%}")
print(f"Worst day: {returns.min():.2%}")
print(f"Avg daily return: {returns.mean():.4%}")
print(f"Return std dev: {returns.std():.4%}")

# Drawdown timeline
drawdowns = metrics.drawdown_series
max_dd_date = drawdowns.idxmax()
print(f"Max drawdown occurred on: {max_dd_date}")
</code></pre>

</main>


<h2 id="configuration">Configuration Parameters</h2>

<table>
<thead>
<tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr>
</thead>
<tbody>
<tr><td><code>start_date</code></td><td><code>datetime</code></td><td><em>required</em></td><td>First day of the backtest simulation (inclusive)</td></tr>
<tr><td><code>end_date</code></td><td><code>datetime</code></td><td><em>required</em></td><td>Last day of the backtest simulation (inclusive)</td></tr>
<tr><td><code>tickers</code></td><td><code>list[str]</code></td><td><em>required</em></td><td>Stock symbols to trade (e.g., ["AAPL", "MSFT", "GOOGL"])</td></tr>
<tr><td><code>initial_capital</code></td><td><code>float</code></td><td>100,000</td><td>Starting cash balance in USD</td></tr>
<tr><td><code>benchmark</code></td><td><code>str</code></td><td>"SPY"</td><td>Benchmark ticker for alpha/beta calculation</td></tr>
<tr><td><code>lookback_days</code></td><td><code>int</code></td><td>365</td><td>Days of historical data to prefetch before start_date</td></tr>
<tr><td><code>risk_free_rate</code></td><td><code>float</code></td><td>0.04</td><td>Annual risk-free rate for Sharpe/Sortino computation</td></tr>
<tr><td><code>max_position_pct</code></td><td><code>float</code></td><td>0.25</td><td>Maximum portfolio weight for a single ticker (backstop)</td></tr>
<tr><td><code>margin_requirement</code></td><td><code>float</code></td><td>1.5</td><td>Short sale margin requirement (1.5 = 150%)</td></tr>
</tbody>
</table>


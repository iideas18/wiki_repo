<table>
<thead><tr><th>Parameter</th><th>Agent(s)</th><th>Default Value</th><th>Description</th></tr></thead>
<tbody>
<tr><td><code>discount_rate</code></td><td>Buffett, Graham, Damodaran</td><td><code>0.10</code> (10%)</td><td>Rate used to discount future cash flows in DCF valuation</td></tr>
<tr><td><code>terminal_growth</code></td><td>Buffett, Graham, Damodaran</td><td><code>0.03</code> (3%)</td><td>Long-term growth rate for terminal value calculation</td></tr>
<tr><td><code>roe_threshold</code></td><td>Buffett, Munger</td><td><code>0.15</code> (15%)</td><td>Minimum acceptable return on equity for "wonderful company"</td></tr>
<tr><td><code>pe_max</code></td><td>Graham</td><td><code>15</code></td><td>Maximum P/E ratio for Graham's value screen</td></tr>
<tr><td><code>pb_max</code></td><td>Graham</td><td><code>1.5</code></td><td>Maximum P/B ratio for Graham's value screen</td></tr>
<tr><td><code>current_ratio_min</code></td><td>Graham</td><td><code>2.0</code></td><td>Minimum current ratio (current assets / current liabilities)</td></tr>
<tr><td><code>peg_max</code></td><td>Lynch</td><td><code>1.0</code></td><td>Maximum PEG ratio for growth-at-reasonable-price</td></tr>
<tr><td><code>margin_of_safety</code></td><td>Buffett, Graham, Burry</td><td><code>0.25</code> (25%)</td><td>Minimum discount to intrinsic value for bullish signal</td></tr>
<tr><td><code>debt_payoff_max_years</code></td><td>Buffett</td><td><code>4</code></td><td>Max years to pay off debt with owner earnings</td></tr>
</tbody>
</table>


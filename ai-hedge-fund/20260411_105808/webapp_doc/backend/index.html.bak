<h2 id="code-examples">Additional Code Examples</h2>

<h3 id="ex-event-class">SSE Event Class Hierarchy</h3>

<pre><code class="language-python">from pydantic import BaseModel
from datetime import datetime
from typing import Optional, List, Any

class BaseEvent(BaseModel):
    type: str
    timestamp: datetime = datetime.utcnow()
    sequence: int = 0

class StartEvent(BaseEvent):
    type: str = "start"
    run_id: str
    agents: List[str]
    total_steps: int

class ProgressUpdateEvent(BaseEvent):
    type: str = "progress"
    agent: str
    progress: float          # 0.0 to 1.0
    status: str              # "running", "completed", "failed"
    data: Optional[Any] = None

class ErrorEvent(BaseEvent):
    type: str = "error"
    agent: str
    error: str
    recoverable: bool = False

class CompleteEvent(BaseEvent):
    type: str = "complete"
    run_id: str
    portfolio: dict
    recommendations: List[dict]</code></pre>

<h3 id="ex-flow-repo">Repository Pattern — FlowRepository</h3>

<pre><code class="language-python">from sqlalchemy.orm import Session
from models.flow import HedgeFundFlow
from typing import Optional, List

class FlowRepository:
    def __init__(self, db: Session):
        self.db = db

    def get_by_id(self, flow_id: str) -> Optional[HedgeFundFlow]:
        return self.db.query(HedgeFundFlow).filter(
            HedgeFundFlow.id == flow_id
        ).first()

    def list_all(self) -> List[HedgeFundFlow]:
        return self.db.query(HedgeFundFlow).order_by(
            HedgeFundFlow.updated_at.desc()
        ).all()

    def create(self, name: str, graph_data: dict) -> HedgeFundFlow:
        flow = HedgeFundFlow(name=name, graph_data=graph_data)
        self.db.add(flow)
        self.db.commit()
        self.db.refresh(flow)
        return flow

    def delete(self, flow_id: str) -> bool:
        flow = self.get_by_id(flow_id)
        if not flow:
            return False
        self.db.delete(flow)
        self.db.commit()
        return True</code></pre>

<h3 id="ex-graph-compile">GraphService — Topological Sort</h3>

<pre><code class="language-python">from collections import deque
from typing import List, Dict

def topological_sort(nodes: List[dict], edges: List[dict]) -> List[str]:
    """Kahn's algorithm for DAG topological ordering."""
    in_degree: Dict[str, int] = {n["id"]: 0 for n in nodes}
    adjacency: Dict[str, List[str]] = {n["id"]: [] for n in nodes}

    for edge in edges:
        src, tgt = edge["source"], edge["target"]
        adjacency[src].append(tgt)
        in_degree[tgt] += 1

    queue = deque([nid for nid, deg in in_degree.items() if deg == 0])
    order = []

    while queue:
        node = queue.popleft()
        order.append(node)
        for neighbor in adjacency[node]:
            in_degree[neighbor] -= 1
            if in_degree[neighbor] == 0:
                queue.append(neighbor)

    if len(order) != len(nodes):
        raise ValueError("Graph contains a cycle — cannot compile to workflow")

    return order</code></pre>


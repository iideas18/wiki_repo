<h2 id="data-flow">Request Lifecycle — Full SSE Data Flow</h2>

<p>This sequence diagram traces every interaction from the moment a user triggers a run to the final result delivery, including error handling paths.</p>

<div class="diagram-container" aria-label="Request lifecycle sequence diagram">
<pre class="mermaid">
sequenceDiagram
    participant Browser as React Frontend
    participant Route as POST /api/hedge-fund/run
    participant GraphSvc as GraphService
    participant FlowRepo as FlowRepository
    participant DB as SQLite
    participant AgentSvc as AgentService
    participant HF as run_hedge_fund()
    participant SSE as EventSourceResponse
    participant Client as SSE Client (Browser)

    Browser->>Route: POST {flow_id, tickers, date_range}
    Route->>GraphSvc: compile(flow_id)
    GraphSvc->>FlowRepo: get_by_id(flow_id)
    FlowRepo->>DB: SELECT FROM hedge_fund_flows WHERE id=?
    DB-->>FlowRepo: Row data
    FlowRepo-->>GraphSvc: HedgeFundFlow instance
    GraphSvc->>GraphSvc: validate_dag(nodes, edges)
    GraphSvc->>GraphSvc: topological_sort(nodes, edges)
    GraphSvc->>GraphSvc: resolve_model_configs(nodes)
    GraphSvc-->>Route: CompiledWorkflow

    Route->>AgentSvc: execute(workflow, tickers, dates)
    Route-->>SSE: Return EventSourceResponse(event_generator)
    Client->>SSE: Open EventSource connection

    AgentSvc-->>SSE: StartEvent {run_id, agents: [...]}
    SSE-->>Client: data: {"type":"start",...}

    AgentSvc->>HF: run_hedge_fund(agents, tickers, dates)
    loop For each agent in workflow
        HF-->>AgentSvc: agent_result
        AgentSvc->>FlowRepo: save_cycle(run_id, agent, result)
        FlowRepo->>DB: INSERT INTO hedge_fund_flow_run_cycles
        AgentSvc-->>SSE: ProgressUpdateEvent {agent, status, data}
        SSE-->>Client: data: {"type":"progress",...}
    end

    AgentSvc->>FlowRepo: save_run(run_id, final_results)
    FlowRepo->>DB: UPDATE hedge_fund_flow_runs SET status='completed'
    AgentSvc-->>SSE: CompleteEvent {portfolio, recommendations}
    SSE-->>Client: data: {"type":"complete",...}
    Client-->>Browser: Render results UI
</pre>
</div>


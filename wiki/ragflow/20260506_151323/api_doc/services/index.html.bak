        <h2>Service Design Patterns</h2>
        
        <h3>Pattern 1: CRUD with Tenant Isolation</h3>
        
        <pre><code>class DialogService(CommonService):
    def create(self, tenant_id: str, name: str, description: str = ""):
        if not name:
            raise ValidationError("name required")
        
        dialog = Dialog.create(
            tenant_id=tenant_id,
            name=name,
            description=description,
            created_by=g.user_id
        )
        self._logger.info(f"Created dialog {dialog.id} in tenant {tenant_id}")
        return dialog
    
    def get(self, dialog_id: str, tenant_id: str = None) -> Dialog:
        dialog = Dialog.get_by_id(dialog_id)
        if tenant_id and dialog.tenant_id != tenant_id:
            raise TenantMismatch(f"Dialog {dialog_id} not in tenant {tenant_id}")
        return dialog
    
    def list_by_tenant(self, tenant_id: str) -> List[Dialog]:
        return Dialog.select().where(
            Dialog.tenant_id == tenant_id,
            Dialog.deleted_at.is_null()
        ).order_by(Dialog.created_at.desc())
</code></pre>
        
        <h3>Pattern 2: State Transition (Task Lifecycle)</h3>
        
        <pre><code>class TaskService(CommonService):
    def create(self, doc_id: str, task_type: str, tenant_id: str) -> Task:
        doc = DocumentService().get(doc_id, tenant_id)
        
        task = Task.create(
            document_id=doc_id,
            tenant_id=tenant_id,
            status="pending",
            task_type=task_type,
            progress_json={"percent": 0, "stage": "queued"}
        )
        
        # Queue task in Redis for background executor
        self._enqueue_task(task)
        return task
    
    def update_progress(self, task_id: str, progress: dict, tenant_id: str):
        task = self.get(task_id, tenant_id)
        task.progress_json = progress
        task.save()
        
        # Notify WebSocket subscribers of progress update
        self._broadcast_progress(task_id, progress)
    
    def mark_done(self, task_id: str, tenant_id: str, result: dict = None):
        task = self.get(task_id, tenant_id)
        task.status = "done"
        task.progress_json = {"percent": 100, "stage": "complete", "result": result}
        task.save()
        
        # Clean up temporary files, send completion notification
        self._finalize_task(task)
</code></pre>
        
        <h3>Pattern 3: Complex Mutation (Document Upload)</h3>
        
        <pre><code>class DocumentService(CommonService):
    def upload(self, file: FileStorage, tenant_id: str, kb_id: str = None):
        '''Upload document: create Document row, save file, create Task, return document.'''
        
        # Validate inputs
        if not file or not file.filename:
            raise ValidationError("file required")
        
        # Create Document row
        doc = Document.create(
            tenant_id=tenant_id,
            name=file.filename,
            file_type=self._get_file_type(file.filename),
            created_by=g.user_id
        )
        
        # Save file to blob storage (S3 or local)
        file_path = self._save_file(file, doc.id)
        doc.file_path = file_path
        doc.save()
        
        # Add to knowledge base if provided
        if kb_id:
            KnowledgebaseService().add_document(kb_id, doc.id, tenant_id)
        
        # Create processing task
        task = TaskService().create(doc.id, "parse_and_embed", tenant_id)
        
        return {"document": doc, "task": task}
    
    def _save_file(self, file: FileStorage, doc_id: str) -> str:
        '''Save file to blob storage; return file path.'''
        # Implementation: write to S3 or local storage
        pass
</code></pre>
        
        <h2>Joint Services for Cross-Domain Coordination</h2>
        
        <p>Some operations require coordinating multiple services atomically. Joint services in <code>joint_services/</code> manage these:</p>
        
        <table>
            <thead>
                <tr>
                    <th>Joint Service</th>
                    <th>File</th>
                    <th>Purpose</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>UserAccountService</td>
                    <td>user_account_service.py</td>
                    <td>Register new user: creates User + Tenant atomically, adds user as tenant owner, sends welcome email</td>
                </tr>
                <tr>
                    <td>MemoryMessageService</td>
                    <td>memory_message_service.py</td>
                    <td>User sends message that should be memorized: creates Message + Memory atomically, tagged with conversation context</td>
                </tr>
                <tr>
                    <td>TenantModelService</td>
                    <td>tenant_model_service.py</td>
                    <td>Configure tenant's default LLM model: updates Tenant settings + LLMModel associations atomically</td>
                </tr>
            </tbody>
        </table>
        
        <h2>Error Handling & Logging</h2>
        
        <p>Services implement consistent error handling and logging:</p>
        
        <pre><code>import logging
from common.exceptions import (
    ValidationError, TenantMismatch, EntityNotFound, InternalError
)

class DocumentService(CommonService):
    def create(self, tenant_id: str, name: str):
        try:
            if not name or len(name) > 255:
                raise ValidationError("name must be 1-255 chars")
            
            doc = Document.create(
                tenant_id=tenant_id,
                name=name,
                created_by=g.user_id
            )
            self._logger.info(f"Created document {doc.id}")
            return doc
            
        except ValidationError:
            raise  # Re-raise domain exceptions
        except IntegrityError as e:
            self._logger.warning(f"DB integrity error: {e}")
            raise ValidationError("name already exists in tenant")
        except Exception as e:
            self._logger.exception(f"Unexpected error creating document: {e}")
            raise InternalError("Failed to create document")
</code></pre>
        
        <h2>Service Dependencies & Cross-References</h2>
        
        <p>Services can call other services for cross-domain operations:</p>
        
        <ul>
            <li><strong>DocumentService → FileService:</strong> Upload document calls FileService.upload() to save file.</li>
            <li><strong>DocumentService → TaskService:</strong> Upload document calls TaskService.create() to queue processing task.</li>
            <li><strong>ConversationService → MessageService:</strong> Start conversation calls MessageService.create() to send welcome message.</li>
            <li><strong>DialogService → LLMService:</strong> Get dialog config calls LLMService.get() to fetch associated LLM model.</li>
            <li><strong>TaskService → ChunkService:</strong> Document parsing task calls ChunkService.batch_create() to insert chunks.</li>
        </ul>
        
        <h2>Tenant Isolation in Services</h2>
        
        <p>Every service method that accesses or modifies data must enforce tenant isolation:</p>
        
        <ul>
            <li><strong>Check tenant_id on read:</strong> When retrieving entity, verify tenant_id matches request's tenant_id.</li>
            <li><strong>Enforce tenant_id on create:</strong> Always set entity.tenant_id = request.tenant_id; never trust user input.</li>
            <li><strong>Filter by tenant_id on list:</strong> All list queries include WHERE tenant_id = ? filter.</li>
            <li><strong>Validate tenant_id on mutation:</strong> Before update/delete, check tenant_id matches.</li>
        </ul>
        
        <h2>Performance Considerations</h2>
        
        <ul>
            <li><strong>Connection Pool:</strong> Services use shared connection pool (10–20). Keep transactions short; avoid long-running DB work in services.</li>
            <li><strong>Query Optimization:</strong> List operations paginate results (default limit 50). Add indexes on tenant_id, created_by, deleted_at.</li>
            <li><strong>Caching:</strong> Services can implement caching for slowly-changing data (LLM models, KnowledgeBases). Use Redis with TTL.</li>
            <li><strong>Deadlock Retry:</strong> Services that perform multi-table updates can retry on deadlock with exponential backoff.</li>
        </ul>
        
        <h2>Security Implications</h2>
        
        <ul>
            <li><strong>No SQL Injection:</strong> Services use Peewee ORM; all queries are parameterized.</li>
            <li><strong>Tenant Data Leaks:</strong> Missing tenant_id check = critical vulnerability. Code review must verify every service method.</li>
            <li><strong>Privilege Escalation:</strong> Services don't enforce role-based access control (admin vs user). That's the API layer's responsibility. Services assume caller is authorized.</li>
            <li><strong>Credential Handling:</strong> Services that work with secrets (LLM API keys) must encrypt at rest, decrypt only when needed, never log.</li>
        </ul>
        
        <h2>Future Enhancements</h2>
        
        <ul>
            <li><strong>Event-Driven Architecture:</strong> Add event publishing (service creates Document → emits DocumentCreated event → other services listen). Loosens coupling.</li>
            <li><strong>Service Versioning:</strong> Support multiple service implementations (DocumentService v1 vs v2) for gradual migration.</li>
            <li><strong>Service Composition:</strong> Build higher-level "use case" services that orchestrate multiple domain services.</li>
            <li><strong>Audit Logging:</strong> Log all mutations (who, what, when, why) for compliance and debugging.</li>
            <li><strong>Transaction Sagas:</strong> For multi-step workflows (upload doc → parse → embed → index), implement saga pattern for failure recovery.</li>
        </ul>
    </main>
    
    <button class="back-to-top" id="back-to-top">↑ Top</button>
    
    <script>
        const themeToggle = document.getElementById('theme-toggle');
        const htmlEl = document.documentElement;
        
        function loadTheme() {
            const theme = localStorage.getItem('neutra-ip-theme') || 'light';
            htmlEl.setAttribute('data-theme', theme);
            themeToggle.textContent = theme === 'dark' ? '☀️' : '🌙';
        }
        
        loadTheme();
        
        themeToggle.addEventListener('click', () => {
            const currentTheme = htmlEl.getAttribute('data-theme');
            const newTheme = currentTheme === 'light' ? 'dark' : 'light';
            htmlEl.setAttribute('data-theme', newTheme);
            localStorage.setItem('neutra-ip-theme', newTheme);
            themeToggle.textContent = newTheme === 'dark' ? '☀️' : '🌙';
        });
        
        const backToTopBtn = document.getElementById('back-to-top');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 300) {
                backToTopBtn.classList.add('visible');
            } else {
                backToTopBtn.classList.remove('visible');
            }
        });
        
        backToTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        
        document.querySelectorAll('pre').forEach((pre) => {
            const code = pre.querySelector('code');
            if (code) {
                const btn = document.createElement('button');
                btn.className = 'copy-btn';
                btn.textContent = 'Copy';
                btn.addEventListener('click', () => {
                    navigator.clipboard.writeText(code.textContent).then(() => {
                        const orig = btn.textContent;
                        btn.textContent = 'Copied!';
                        setTimeout(() => { btn.textContent = orig; }, 2000);
                    });
                });
                pre.appendChild(btn);
            }
        });
    </script>

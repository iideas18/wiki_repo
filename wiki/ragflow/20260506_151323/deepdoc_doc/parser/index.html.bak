<script>
function themeToggle(){const t=document.documentElement;const c=t.getAttribute('data-theme')||'dark';const n=c==='dark'?'light':'dark';t.setAttribute('data-theme',n);localStorage.setItem('neutra-ip-theme',n);document.getElementById('themeToggle').textContent=n==='dark'?'🌙':'☀️'}
const saved=localStorage.getItem('neutra-ip-theme')||'dark';document.documentElement.setAttribute('data-theme',saved);document.getElementById('themeToggle').textContent=saved==='dark'?'🌙':'☀️';
document.getElementById('themeToggle').addEventListener('click',themeToggle);
mermaid.initialize({startOnLoad:false,theme:document.documentElement.getAttribute('data-theme')||'dark',securityLevel:'loose'});
function renderAllMermaid(){const t=document.documentElement.getAttribute('data-theme')||'dark';document.querySelectorAll('.mermaid').forEach(e=>{if(e.textContent&&!e.hasAttribute('data-processed')){mermaid.render('mermaid_'+Math.random(),e.textContent,s=>{const c=document.createElement('div');c.innerHTML=s;const d=c.querySelector('svg');if(d){e.textContent='';e.appendChild(d);e.setAttribute('data-processed','true')}})}})}
renderAllMermaid();
document.getElementById('themeToggle').addEventListener('click',()=>{setTimeout(renderAllMermaid,100)});
const overlay=document.getElementById('diagramOverlay');const diagrams=document.querySelectorAll('.diagram-container');
diagrams.forEach(e=>{e.addEventListener('click',()=>{let s=e.querySelector('svg');if(!s){return}let c=s.cloneNode(true);c.style.maxWidth='100%';c.style.height='auto';overlay.innerHTML='';let d=document.createElement('div');d.className='diagram-overlay-content';d.appendChild(c);overlay.appendChild(d);overlay.classList.add('active')});});
overlay.addEventListener('click',()=>overlay.classList.remove('active'));
overlay.addEventListener('wheel',e=>{e.preventDefault();let s=overlay.querySelector('svg');if(!s)return;let c=parseFloat(s.style.transform?.match(/scale\(([\d.]+)\)/)?.[1]||1);c+=e.deltaY>0?.9:1.1;s.style.transform=`scale(${c})`},false);
window.addEventListener('scroll',()=>{const t=document.getElementById('backToTop');t?window.scrollY>300?t.classList.add('visible'):t.classList.remove('visible'):null});
const bt=document.getElementById('backToTop');if(bt)bt.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));
hljs.highlightAll();
const codeBlocks=document.querySelectorAll('pre code');codeBlocks.forEach(e=>{const t=document.createElement('button');t.className='copy-btn';t.textContent='Copy';t.style.cssText='position:absolute;top:0;right:0;padding:4px 8px;background:var(--accent);color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:.8rem;';const s=document.createElement('div');s.style.position='relative';e.parentNode.insertBefore(s,e);s.appendChild(e);s.insertBefore(t,e);t.addEventListener('click',()=>{const c=e.textContent;navigator.clipboard.writeText(c).then(()=>{const d=t.textContent;t.textContent='Copied!';setTimeout(()=>t.textContent=d,2000)})})});
</script>
